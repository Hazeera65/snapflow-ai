# SnapFlow AI Environment Configuration
# Copy this file to .env and adjust values as needed

# Backend
SNAPFLOW_HOST=127.0.0.1
SNAPFLOW_PORT=8000
SNAPFLOW_ENVIRONMENT=development

# Model paths
MODELS_DIR=./models
DATA_DIR=./data

# Feature flags
ENABLE_VOICE_INPUT=false
ENABLE_GPU=true
ENABLE_QNN=true

# API Configuration
API_TIMEOUT=30
MAX_FILE_SIZE_MB=50
MAX_DOCUMENTS=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development
DEBUG=false
RELOAD=true
